# -------------------------------------------------------------------
# Kickoff IA — variables sensibles. NUNCA subas el archivo .env real.
# En este proyecto el "backend" es Google Apps Script, así que estos
# valores NO se leen de un archivo .env: se cargan como Script Properties.
#
# Cómo: Apps Script > Project Settings > Script properties > Add property
# -------------------------------------------------------------------

# PIN de la administradora (4 a 6 dígitos). Obligatorio.
ADMIN_PIN=0000

# Nombre que dispara el acceso de administradora.
# Opcional: si no se define, el backend usa este valor por defecto.
ADMIN_NAME=Erendira Alejandra Hernández Loza
